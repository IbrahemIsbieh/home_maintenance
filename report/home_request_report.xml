<odoo>
    <record id="home_request_report" model="ir.actions.report">
        <field name="name">Maintenance Request</field>
        <field name="model">home.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">home_maintenance.report_home_request_document</field>
        <field name="binding_model_id" ref="model_home_request"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_home_request_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                     <div class="page">
                         <h2>Maintenance Request <span t-field="o.name"/></h2>
                         <h4 t-field="o.title"/>
                         <table class="table table-sm mt-4">
                             <tr>
                                 <th style="width: 25%;">Status</th>
                                 <td><span t-field="o.state"/></td>
                                 <th style="width: 25%;">Priority</th>
                                 <td><span t-field="o.priority"/></td>
                             </tr>
                             <tr>
                                 <th>Customer</th>
                                 <td><span t-field="o.partner_id"/></td>
                                 <th>Technician</th>
                                 <td><span t-field="o.technician_id"/></td>
                             </tr>
                             <tr>
                                 <th>Property</th>
                                  <td colspan="3">
                                      <span t-field="o.property_id.name"/>
                                      <t t-if="o.property_id.street or o.property_id.city">
                                          - <span t-field="o.property_id.street"/>
                                          <span t-field="o.property_id.city"/>
                                      </t>
                                  </td>
                             </tr>
                         </table>
                         <h5 class="mt-4">Description</h5>
                         <p t-field="o.description"/>
                         <t t-if="o.state == 'cancelled'">
                             <h5 class="mt-4">Cancellation reason</h5>
                             <p t-field="o.cancel_reason"/>
                         </t>
                         <h5 class="mt-4">Visits</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Technician</th>
                                    <th>Duration (h)</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.visit_ids" t-as="v">
                                    <tr>
                                        <td><span t-field="v.visit_date"/></td>
                                        <td><span t-field="v.technician_id"/></td>
                                        <td><span t-field="v.duration" t-options='{"widget": "float_time"}'/></td>
                                        <td><span t-field="v.state"/></td>
                                    </tr>
                                </t>
                                <tr t-if="not o.visit_ids">
                                    <td colspan="4" class="text-muted text-center">No visits scheduled</td>
                                </tr>
                            </tbody>

                        </table>

                     </div>
                </t>
            </t>
        </t>
    </template>
</odoo>