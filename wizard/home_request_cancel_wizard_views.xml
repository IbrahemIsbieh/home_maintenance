<odoo>
    <record id="view_home_request_cancel_wizard_form" model="ir.ui.view">
        <field name="name">view_home_request_cancel_wizard_form</field>
        <field name="model">home.request.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Why is this request being cancelled?"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm Cancellation" type="object" claas="btn-primary"/>
                    <button name="" string="Discard" special="cancel" claas="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_home_request_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Request</field>
        <field name="res_model">home.request.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>