<odoo>
    <record id="home_slot_list" model="ir.ui.view">
        <field name="name">home_slot_list</field>
        <field name="model">home.slot</field>
        <field name="arch" type="xml">
            <list>
                <field name="slot_start"/>
                <field name="technician_id"/>
                <field name="duration" widget="float_time"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="home_slot_form" model="ir.ui.view">
        <field name="name">home_slot_form</field>
        <field name="model">home.slot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="technician_id"/>
                            <field name="slot_start"/>
                        </group>
                        <group>
                            <field name="duration" widget="float_time"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requests">
                            <field name="request_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_home_slot" model="ir.actions.act_window">
        <field name="name">Available Slots</field>
        <field name="res_model">home.slot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>