<odoo>
    <record id="home_request_list" model="ir.ui.view">
        <field name="name">home_request_list</field>
        <field name="model">home.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="title"/>
                <field name="property_id"/>
                <field name="slot_id" optional="show"/>
                <field name="partner_id"/>
                <field name="technician_id"/>
                <field name="priority"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="home_request_form" model="ir.ui.view">
        <field name="name">home_request_form</field>
        <field name="model">home.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(home_maintenance.action_home_request_schedule_wizard)d"
                            string="Schedule" type="action"
                            context="{'default_request_id': id}"
                            class="btn-primary"
                            groups="home_maintenance.group_home_manager"
                            invisible="state != 'new'"/>

                    <button name="action_start" string="Start Work" type="object"
                            class="btn-primary"
                            groups="home_maintenance.group_home_technician,home_maintenance.group_home_manager"
                            invisible="state != 'scheduled'"/>

                    <button name="action_done" string="Mark Done" type="object"
                            class="btn-primary"
                            groups="home_maintenance.group_home_technician,home_maintenance.group_home_manager"
                            invisible="state != 'in_progress'"/>

                    <button name="%(home_maintenance.action_home_request_cancel_wizard)d"
                            string="Cancel" type="action"
                            context="{'default_request_id': id}"
                            groups="home_maintenance.group_home_manager"
                            invisible="state in ('done', 'cancelled')"/>

                    <button name="action_reset" string="Reset to New" type="object"
                            groups="home_maintenance.group_home_manager"
                            invisible="state != 'cancelled'"/>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="property_id"/>
                            <field name="slot_id" readonly="state != 'new'"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="technician_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="cancel_reason" invisible="state != 'cancelled'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe the problem..."/>
                        </page>
                        <page string="Visits">
                             <field name="visit_ids">
                                 <list>
                                     <field name="visit_date"/>
                                     <field name="technician_id"/>
                                     <field name="duration" widget="float_time"/>
                                     <field name="state" widget="badge"/>
                                 </list>
                             </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>

            </form>
        </field>
    </record>
    <record id="action_home_request" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">home.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>